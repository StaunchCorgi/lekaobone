---
import { getCollection } from "astro:content";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEO from "../../components/SEO.astro";

const posts = (
  await getCollection("blog", ({ data }) => !data.draft)
).sort(
  (a, b) =>
    b.data.publishDate.valueOf() -
    a.data.publishDate.valueOf()
);

const canonicalURL = new URL("/blog/", Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <SEO
      title="Website, SEO and Digital Growth Resources | Leka O Bone"
      description="Practical website, SEO and digital growth guidance for service-based and inclusive businesses."
      canonicalURL={canonicalURL}
    />
  </head>

  <body>
    <Header />

    <main class="blog-page">
      <section class="blog-hero">
        <span class="blog-eyebrow">Resources</span>

        <h1>
          Build a stronger and more visible business online.
        </h1>

        <p>
          Practical guides about websites, SEO, digital growth and
          building trust online.
        </p>
      </section>

      <section class="blog-grid" aria-label="Latest articles">
        {posts.map((post) => (
          <article class="blog-card">
            <a
              class="blog-card__image"
              href={`/blog/${post.id}/`}
              aria-label={`Read ${post.data.title}`}
            >
              <img
                src={post.data.image}
                alt={post.data.imageAlt}
                width="600"
                height="315"
                loading="lazy"
              />
            </a>

            <div class="blog-card__body">
              <span class="blog-card__category">
                {post.data.category}
              </span>

              <h2>
                <a href={`/blog/${post.id}/`}>
                  {post.data.title}
                </a>
              </h2>

              <p>{post.data.description}</p>

              <div class="blog-card__meta">
                <time datetime={post.data.publishDate.toISOString()}>
                  {post.data.publishDate.toLocaleDateString(
                    "en-ZA",
                    {
                      day: "numeric",
                      month: "long",
                      year: "numeric",
                    }
                  )}
                </time>
              </div>
            </div>
          </article>
        ))}
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .blog-page {
    padding: 8rem 1.5rem 6rem;
  }

  .blog-hero {
    width: min(850px, 100%);
    margin: 0 auto 4rem;
    text-align: center;
  }

  .blog-eyebrow {
    display: inline-block;
    margin-bottom: 1rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .blog-hero h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.75rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .blog-hero p {
    max-width: 670px;
    margin: 1.5rem auto 0;
    font-size: 1.15rem;
    line-height: 1.7;
    color: #6b7280;
  }

  .blog-grid {
    width: min(1180px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .blog-card {
    overflow: hidden;
    border: 1px solid rgba(20, 20, 30, 0.1);
    border-radius: 1.25rem;
    background: #fff;
  }

  .blog-card__image {
    display: block;
    overflow: hidden;
  }

  .blog-card__image img {
    width: 100%;
    aspect-ratio: 600 / 315;
    display: block;
    object-fit: cover;
    transition: transform 250ms ease;
  }

  .blog-card:hover img {
    transform: scale(1.03);
  }

  .blog-card__body {
    padding: 1.5rem;
  }

  .blog-card__category {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .blog-card h2 {
    margin: 0.75rem 0;
    font-size: 1.4rem;
    line-height: 1.3;
  }

  .blog-card h2 a {
    color: inherit;
    text-decoration: none;
  }

  .blog-card p {
    color: #6b7280;
    line-height: 1.65;
  }

  .blog-card__meta {
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: #6b7280;
  }

  @media (max-width: 900px) {
    .blog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>