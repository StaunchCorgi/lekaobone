---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Thank You | Leka O Bone">

    <main class="thank-you">

        <div class="thank-you__card">

            <span class="thank-you__icon">✓</span>

            <h1>Thank you for reaching out.</h1>

            <p>
                Your enquiry has been received. We will review your
                project details and get back to you as soon as possible.
            </p>

            <a href="/" class="btn btn--primary">
                Return Home
            </a>

        </div>

    </main>

</BaseLayout>