<section class="contact" id="contact">
    <div class="container contact__container">

        <div class="contact__form">

            <h2>Let's build your digital presence.</h2>

            <form action="https://formspree.io/f/meeyykwp" method="POST">
                <input
                    type="hidden"
                    name="_subject"
                    value="New Leka O Bone website enquiry"
                />
                <input
                    type="text"
                    name="_gotcha"
                    class="form-honeypot"
                    tabindex="-1"
                    autocomplete="off"
                />

                <label>Full Name</label>
                <input type="text" placeholder="Your name"  name="name" />

                <label>Email</label>
                <input type="email" placeholder="you@example.com" name="email" />

                <label>Business Name</label>
                <input type="text" placeholder="Your business name" name="business" />

                <label>What do you need?</label>
                <select name="service">
                    <option>Website Design & Development</option>
                    <option>Business Software</option>
                    <option>AI Automation</option>
                    <option>SEO & Digital Marketing</option>
                    <option>Website Care & Maintenance</option>
                    <option>Not Sure Yet</option>
                </select>

                <label>Estimated Budget</label>
                <select name="budget" >
                    <option>Let's Discuss</option>
                    <option>Under R5,000</option>
                    <option>R5,000 - R10,000</option>
                    <option>R10,000 - R25,000</option>
                    <option>R25,000+</option>
                </select>

                <label>Message</label>
                <textarea name="message" rows="6"
                    placeholder="Tell us what you want to build"></textarea>

                <button class="btn btn--primary">
                    Send enquiry
                </button>

            </form>

        </div>

        <aside class="contact__info">

            <h3>Prefer WhatsApp?</h3>

            <p>
                Send a quick message and we'll discuss your
                business, goals and best solution.
            </p>

            <a href="https://wa.me/27679537768" class="btn btn--secondary">
                Message on WhatsApp
            </a>

            <div class="contact__details">
                <p><strong>Email:</strong> lekaobone@gmail.com</p>
                <p><strong>Response:</strong> Within one business day</p>
            </div>

        </aside>

    </div>
</section>