<section class="contact" id="contact">
    <div class="container contact__container">

        <div class="contact__form">

            <h2>Let's build your digital presence.</h2>

            <form action="https://formspree.io/f/meeyykwp" method="POST">
                <input
                    type="hidden"
                    name="_subject"
                    value="New Leka O Bone Healthcare Practice Enquiry"
                />
                <input
                    type="text"
                    name="_gotcha"
                    class="form-honeypot"
                    tabindex="-1"
                    autocomplete="off"
                />

                <label>Full Name</label>
                <input type="text" placeholder="Your name"  name="name" />

                <label>Email</label>
                <input type="email" placeholder="you@practice.com" name="email" />

                <label>Practice Name</label>
                <input type="text" placeholder="Your practice name" name="practice" />

               <label for="practice-type">Practice Type</label>
                <select
                    id="practice-type"
                    name="practiceType"
                >
                    <option value="">Select your practice type</option>
                    <option>General Practitioner</option>
                    <option>Dentist</option>
                    <option>Psychologist / Therapist</option>
                    <option>Physiotherapist</option>
                    <option>Specialist Practice</option>
                    <option>Allied Health Practice</option>
                    <option>Medical Centre</option>
                    <option>Other</option>
                </select>

                <label for="service">How can we help?</label>
                <select
                    id="service"
                    name="service"
                    required
                >
                    <option value="">Select a solution</option>
                    <option>Healthcare Website Design</option>
                    <option>Online Booking & Patient Enquiries</option>
                    <option>Practice Management System</option>
                    <option>Appointment & Workflow Automation</option>
                    <option>Local SEO & Patient Discovery</option>
                    <option>Website Care & Support</option>
                    <option>Not Sure Yet</option>
                </select>

                <label for="challenge">What is your biggest challenge?</label>
                <select
                    id="challenge"
                    name="challenge"
                >
                    <option value="">Select a challenge</option>
                    <option>Not enough patient enquiries</option>
                    <option>Too much reception or admin work</option>
                    <option>No online booking</option>
                    <option>Poor Google visibility</option>
                    <option>Outdated or ineffective website</option>
                    <option>Need a custom practice system</option>
                    <option>Other</option>
                </select>

                <label>Estimated Budget</label>
                <select name="budget" >
                    <option>Let's Discuss</option>
                    <option>Under R5,000</option>
                    <option>R5,000 - R10,000</option>
                    <option>R10,000 - R25,000</option>
                    <option>R25,000+</option>
                </select>

                <label>Message</label>
                <textarea
                    id="message"
                    name="message"
                    rows="6"
                    placeholder="Tell us about your current setup, challenges and what you'd like to improve."
                ></textarea>

                <button class="btn btn--primary">
                    Request a Practice Consultation
                </button>

            </form>

        </div>

        <aside class="contact__info">

            <h3>Prefer WhatsApp?</h3>

            <p>
                Send a quick message and we'll discuss your
                business, goals and best solution.
            </p>

            <a href="https://wa.me/27679537768" class="btn btn--secondary">
                Message on WhatsApp
            </a>

            <div class="contact__details">
                <p><strong>Email:</strong> lekaobone@gmail.com</p>
                <p><strong>Response:</strong> Within one business day</p>
            </div>

        </aside>

    </div>
</section>