---
import HeroBadge from "./HeroBadge.astro";
import HeroHeading from "./HeroHeading.astro";
import HeroDescription from "./HeroDescription.astro";
import HeroButtons from "./HeroButtons.astro";
import HeroGraphic from "./HeroGraphic.astro";
---

<section class="hero">

    <div class="hero__background"></div>
 
    <div class="hero__container">

        <div class="hero__left">

            <HeroBadge />

            <HeroHeading />

            <HeroDescription />

            <HeroButtons /> 

        </div>
        <div class="hero__right">

            <HeroGraphic/>
            
        </div>

    </div>

</section>