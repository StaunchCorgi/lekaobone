---
import ServiceCard from "./ServiceCard.astro";
import "../style/services.css";

const services = [
    {
        icon: "🌐",
        title: "Healthcare Website Design",
        description:
            "Professional, mobile-friendly websites that help private practices build trust, showcase their services and turn visitors into patient enquiries."
    },
    {
        icon: "📅",
        title: "Online Booking & Patient Enquiries",
        description:
            "Make it easier for patients to request appointments, contact your practice and find the information they need without relying entirely on phone calls."
    },
    {
        icon: "⚙️",
        title: "Practice Management Systems",
        description:
            "Custom software for patient administration, appointment management, internal workflows and the day-to-day needs of your practice."
    },
    {
        icon: "🔔",
        title: "Workflow & Appointment Automation",
        description:
            "Reduce repetitive administration with automated appointment reminders, confirmations, follow-ups and other routine practice workflows."
    },
    {
        icon: "🔍",
        title: "Local SEO & Patient Discovery",
        description:
            "Improve your practice's visibility on Google so patients searching for healthcare services in your area can find you more easily."
    },
    {
        icon: "🛡️",
        title: "Website Care & Support",
        description:
            "Keep your practice website secure, fast and up to date with ongoing maintenance, monitoring, backups and technical support."
    }
];
---

<section class="services" id="services">

    <div class="container">

        <span class="section-tag">
            Digital Solutions for Healthcare
        </span>

        <h2 class="section-title">
            Technology that helps your practice
            <span>work smarter and grow.</span>
        </h2>

        <p class="section-description">
            From attracting new patients to reducing repetitive
            administration, we build digital solutions around the
            everyday needs of private healthcare practices.
        </p>

        <div class="services__grid">

            {services.map((service) => (
                <ServiceCard {...service} />
            ))}

        </div>

    </div>

</section>