---
const currentPath = Astro.url.pathname;

const links = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/portfolio", label: "Portfolio" },
  { href: "/blog", label: "Resources" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" }
];
---

<header class="site-header">
    <div class="container">

        <a href="/" class="logo">
            <span class="logo-mark">LB</span>

            <div class="logo-text">
                <strong>Leka O Bone</strong>
                <small>Experience it yourself.</small>
            </div>
        </a>

        <nav class="nav">

            {
                links.map(link => (
                    <a
                        href={link.href}
                        class:list={[
                            "nav-link",
                            currentPath === link.href && "active"
                        ]}
                    >
                        {link.label}
                    </a>
                ))
            }

        </nav>

        <a
            href="/contact"
            class="cta"
        >
            Start Project
        </a>

    </div>
</header>

<style>

.site-header{
    position:sticky;
    top:0;
    z-index:1000;

    backdrop-filter:blur(18px);

    background:rgba(255,255,255,.82);

    border-bottom:1px solid rgba(0,0,0,.06);
}

.container{

    width:min(1200px,calc(100% - 2rem));

    margin-inline:auto;

    display:flex;

    justify-content:space-between;

    align-items:center;

    height:82px;
}

.logo{

    display:flex;

    align-items:center;

    gap:1rem;

    color:inherit;

    text-decoration:none;
}

.logo-mark{

    width:46px;

    aspect-ratio:1;

    border-radius:50%;

    display:grid;

    place-items:center;

    font-weight:700;

    color:white;

    background:linear-gradient(
        135deg,
        #7c3aed,
        #9333ea
    );
}

.logo-text{

    display:flex;

    flex-direction:column;
}

.logo-text strong{

    font-size:1rem;

    line-height:1;
}

.logo-text small{

    color:#777;

    margin-top:.25rem;

    font-size:.8rem;
}

.nav{

    display:flex;

    gap:2rem;
}

.nav-link{

    color:#555;

    text-decoration:none;

    font-weight:500;

    transition:.25s;
}

.nav-link:hover{

    color:#7c3aed;
}

.active{

    color:#7c3aed;

    font-weight:700;
}

.cta{

    text-decoration:none;

    color:white;

    background:#111827;

    padding:.85rem 1.25rem;

    border-radius:999px;

    font-weight:600;

    transition:.25s;
}

.cta:hover{

    transform:translateY(-2px);

    background:#7c3aed;
}

@media(max-width:900px){

.nav{

display:none;

}

.logo-text small{

display:none;

}

}

</style>